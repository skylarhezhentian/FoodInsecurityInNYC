% Gemini theme
% https://github.com/anishathalye/gemini

% ====================
% Definitions
% ====================

% Colors from https://www.cam.ac.uk/brand-resources/guidelines/typography-and-colour/rgb-and-hex-references

% Old Cambridge: 
%\definecolor{camblue}{RGB}{0, 62, 114}

% New Columbia:
% https://sps.columbia.edu/visual-identity/color-palette
% Dark Blue: R1 G33 B105
% Medium Blue: R0 G158 B255
% 

%
% change this as per:
% https://sps.columbia.edu/visual-identity/color-palette
%
\definecolor{camblue}{RGB}{0, 158, 255}

% Extra colors
\definecolor{lightgray}{RGB}{240, 240, 240}
\definecolor{lightorange}{RGB}{255, 245, 242}
% Define Columbia Blue
\definecolor{ColumbiaBlue}{HTML}{1D4F91}

\definecolor{PrimaryBlue}{HTML}{1D4F91}
\definecolor{SecondaryBlue1}{HTML}{003087}
\definecolor{SecondaryBlue2}{HTML}{0077C8}
\definecolor{SecondaryBlue3}{HTML}{6CACE4}


% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=black,bg=white}
\setbeamercolor{palette secondary}{fg=black,bg=white}
\setbeamercolor{palette tertiary}{bg=black,fg=white}
\setbeamercolor{palette quaternary}{fg=black,bg=white}
\setbeamercolor{structure}{fg=camblue}
%\setbeamercolor{structure}{fg=ColumbiaBlue}
% Headline
%\setbeamercolor{headline}{fg=white,bg=camblue}
% Update headline and structure colors
\setbeamercolor{headline}{fg=white,bg=ColumbiaBlue}
% Block
\setbeamercolor{block title}{fg=SecondaryBlue2,bg=white}
\setbeamercolor{block separator}{bg=black}
\setbeamercolor{block body}{fg=black,bg=white}

% Alert Block
\setbeamercolor{block alerted title}{fg=SecondaryBlue2,bg=lightorange}
\setbeamercolor{block alerted separator}{bg=black}
\setbeamercolor{block alerted body}{fg=black,bg=lightorange}

% Example Block
\setbeamercolor{block example title}{fg=SecondaryBlue2,bg=lightgray}
\setbeamercolor{block example separator}{bg=black}
\setbeamercolor{block example body}{fg=black,bg=lightgray}

% Heading
\setbeamercolor{heading}{fg=black}

% Itemize
\setbeamercolor{item}{fg=camblue}

% Bibliography
\setbeamercolor{bibliography item}{fg=black}
\setbeamercolor{bibliography entry author}{fg=black}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}
